{
  "name": "cake-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "npx -r dotenv/config drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "npx -r dotenv/config drizzle-kit migrate --config=drizzle.config.ts",
    "db:create-table": "npx -r dotenv/config tsx src/db/manual-migration.ts",
